@node interlinktoolkitsite_map
@subsection interlink.toolkit.site_map()
@anchor{#interlink.toolkit.site_map}
Produces a clickable list of all URL's within the project, minus any
``GET'' requests.

@verbatim
def has_no_empty_params(rule):
  defaults = rule.defaults if rule.defaults is not None else ()
  arguments = rule.arguments if rule.arguments is not None else ()
  return len(defaults) >= len(arguments)

def site_map():
  links = []
  for rule in app.url_map.iter_rules():
  # Filter out rules we can't navigate to in a browser
  # and rules that require parameters
    if "GET" in rule.methods and has_no_empty_params(rule):
      url = url_for(rule.endpoint, **(rule.defaults or @{@}))
      links.append((url, rule.endpoint))
  # links is now a list of url, endpoint tuples
  return links
@end verbatim

@node interlinktoolkitDBdb user password
@subsection interlink.toolkit.DB(db, user, password)
@anchor{#interlink.toolkit.dbdb-user-password}
Creates a connection to a SQL database.

@verbatim
class DB:
  def __init__(self, db, user, password):
    self.db = db
    self.user = user
    self.password = password
  def connect(self):
    mydb = mysql.connector.connect(
    host='localhost',
    database=os.environ.get(self.db),
    user=os.environ.get(self.user),
    password=os.environ.get(self.password)
    )
    return mydb
  def close(self):
    db = DB(self.db, self.user, self.password)
    if db is not None:
      db.close()
@end verbatim

@verbatim
`__init__(self, db, user, password)`  
Initalize the connection, create the object.  
    `db`  
    The name of the Environment Variable for the database  
    `user`  
    The name of the Environment Variable for the user which has access to the database  
    `password`  
    The name of the Environment Variable for the password of the user which has access to the database  
`connect(self)`  
Create the connection to the database for creating the cursor.  
`close(self)`  
Close the connection to the database  
@end verbatim

@node interlinkformulatorGeneratordb user password
@subsection interlink.formulator.Generator(db, user, password)
@anchor{#interlink.formulator.generatordb-user-password}
Create the object for generating your form, report, query, or nav.

@verbatim
class Generator: 
  def __init__(self, db, user, password):
    self.db = db
    self.user = user
    self.password = password
    
  def generateForm(self, table):
    error, form = createForm(self.db, self.user, self.password, table)
    title = table
    return error, form, title
    
  def generateReport(self, table):
    colName, colRow, error = createReport(self.db, self.user, self.password, table)
    title = table
    return colName, colRow, error, title
    
  def generateQuery(self, table):
    return createQuery(self.db, self.user, self.password, table)
    
  def generateNav(self):
    return createNav(self.db, self.user, self.password)
@end verbatim

@verbatim
`__init__(self, db, user, password)`  
Initalize the connection, create the object.  
    `db`  
    The name of the Environment Variable for the database  
    `user`  
    The name of the Environment Variable for the user which has access to the database  
    `password`  
    The name of the Environment Variable for the password of the user which has access to the database  
`generateForm(self, table)`  
Generate the Form, URL, and Template for said @code{table} in database. Variables returned are `error` `form` `title`  
`generateReport(self, table)`
Generate the Report, URL, and Template for said @code{table} in database. Variables returned are @code{error} @code{table} @code{colName} @code{colRow}
`generateQuery(self, table)`
Generate a Query for said @code{table} in database. Unlike creating a URL and Template, you can create a variable to be used in a template.
`generateNav(self)`
Generate a Navigation Bar for said @code{table} in database. It basically just finds the table names, rather than the table data.
@end verbatim

@node interlinksafeHaven@@honeypotf
@subsection interlink.safeHaven.@@honeypot(f)
@anchor{#interlink.safehaven.honeypotf}
@@url@{https://peps.python.org/pep-0318/, See: Python Decorator@} Python
decorator you can use as a honeypot. Any IP Adress that is black listed
will be redirected to a login page that logs the username and password
they attempt to use.

@verbatim
def honeypot(f):
  @wraps(f)
  def decorated_function(*args, **kwargs):
    if session == @{@}:
      ip = request.remote_addr
      for b in blacklist:
        if ip in blacklist:
          print(" *", str(d.now()) + ' -->', "This IP is blacklisted:", ip)
          print(" *", str(d.now()) + ' -->', "This IP is blacklisted:", ip, file=open(os.environ.get('LOG_DIR') + '/pads.log', 'a'))
          return redirect(url_for('templeton.loginRequired'))
    return f(*args, **kwargs)
  return decorated_function
@end verbatim

@node interlinksafeHaven@@backdoorf
@subsection interlink.safeHaven.@@backdoor(f)
@anchor{#interlink.safehaven.backdoorf}
Python decorator you can use as a backdoor. Any page which has this
decorator will give IP Address' on the whitelist full access to the
page.

@verbatim
def backdoor(f):
  @wraps(f)
  def decorated_function(*args, **kwargs):
    if session == @{@}:
      ip = request.remote_addr
      for w in whitelist:
        if ip in whitelist:
          session['yourballslooklikemine'] = ip
    return f(*args, **kwargs)
  return decorated_function
@end verbatim

@node interlinksafeHaven@@loginf
@subsection interlink.safeHaven.@@login(f)
@anchor{#interlink.safehaven.loginf}
Python decorator you can use to check if a user is logged in. If not,
they will be redirected to a login page from where they can log in.

@verbatim
def login(f):
  @wraps(f)
  def decorated_function(*args, **kwargs):
    if session == @{@}:
      ip = request.remote_addr
      print(" * [USER]", str(d.now()) + ' -->', ip, "directed to login")
      print(" * [USER]", str(d.now()) + ' -->', ip, "directed to login", file=open(os.environ.get('LOG_DIR') + '/pads.log', 'a'))
      return redirect(url_for('templeton.secure_login'))
    return f(*args, **kwargs)
  return decorated_function
@end verbatim

@node interlinktempletonTempulationobject
@subsection interlink.templeton.Tempulation(object)
@anchor{#interlink.templeton.tempulationobject}
If you don't like templetons tempulator, you can use its Templulation to
create your own!

@verbatim
class Tempulation(object):
    def __init__(self, import_name):
        self.__module__, self.__name__ = import_name.rsplit('.', 1)
        self.import_name = import_name
    @cached_property
    def view(self):
        return import_string(self.import_name)
    def __call__(self, *args, **kwargs):
        return self.view(*args, **kwargs)
@end verbatim

@node interlinktempletontempulatorimport_name url_rules=[] **options
@subsection interlink.templeton.tempulator(import_name, url_rules=[],
**options)
@anchor{#interlink.templeton.tempulatorimport_name-url_rules-options}
Used to generate generic templates from templeton directory of templates

@verbatim
tempulator('views.catalog', ['/catalog'])
@end verbatim

@verbatim
def tempulator(import_name, url_rules=[], **options):
    view = Tempulation(f"@{__name__@}.@{import_name@}")
    for url_rule in url_rules:
      app.add_url_rule(url_rule, view_func=view, **options)
@end verbatim

@node interlinktempletontempletonBP
@subsection interlink.templeton.templetonBP
@anchor{#interlink.templeton.templetonbp}
Used if you would like to register templeton's Blueprint within your
project. Mostly used to generate templeton's Forms, Report, and URL's.

@verbatim
templates = os.path.dirname(__file__) + '/templates/'
templetonBP = Blueprint('templeton', __name__, url_prefix='/', template_folder=templates)
@templetonBP.errorhandler(404)
@templetonBP.errorhandler(500)
@templetonBP.route('/guide/<page>')
@templetonBP.route('/interlink/')
@templetonBP.route('/loginRequired/', methods=['GET', 'POST'])
@templetonBP.route('/login/', methods=['GET', 'POST'])
@templetonBP.route('/register/', methods=['GET', 'POST'])
@templetonBP.route('/reports/<db>/<page>')
@templetonBP.route('/forms/<db>/<page>', methods=['GET', 'POST'])
@templetonBP.route('/admin/<db>')
@end verbatim
