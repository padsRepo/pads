## note
## - Logic files which needs `getopts` will be created as a new binary command in /$baseDir/bin
## - All documentation is now within the respective code. It used to all be jammed in here.
## - The PADS command has evolved into a set of libraries which work interchangeably.
## end note

## seealso padsutils, paddocs, man pads, info pads

title="PADS"
subtitle="Personal Assistant and Deployment System"
version="0.1.6"
OPTSTRING="B:,C:,M:,U:,T:,D,x,v,h"
#OPTSTRING="B:,C:,M:,U:,S:,P:,R:,T,x,v,h"
synopsis="<cmd> -[<module>] -[<argument>] [name...]"
syntax="${0##*/} -[${OPTSTRING}] -[arg]"
baseDir="$(dirname "$(readlink -f "${0%/*}")")"

. "/opt/pads/padsutils/config/pads.rc"
#. ${baseDir}/padsutils/logging/exit_codes.sh

description(){
  cat << EOF
 * ${title}
 * ${subtitle}

EOF
}

usage(){
  cat << EOF
  Synopsis: $synopsis
  Syntax: $syntax
  Usage:
    -B [-h] Build lib into PKGBUILD
    -C [-h] Create new projects
    -D [-h] Dryrun Module
    -T [-h] Generate templates
    -U [-h] Update the repository with pkgname
    -x      Set -x
    -v      Show Version
    -h      Show Usage
  Ex: pads -Mp padsutils > PKGBUILD | pads -Bp padsutils | pads -Ur padsutils
  See also: man pads, info pads
EOF
}

manual(){
  description
  usage
}

# Workflow: create -> make -> build -> update
while getopts ${OPTSTRING} mod; do
  mod=${mod}
  case ${mod} in
    B) 
      shift $((OPTIND - 1))
      . "${baseDir}/${0##*/}/build.sh"
      case $OPTARG in
        "p" | "-p" | "--pkgbuild") pkgbuild ${@};;
        "m" | "-m" | "--metapkg") metapkg "${@}";;
        "t" | "-t" | "--test") dryrun ${@};;
        "h" | "-h" | "--help") usage;;
        ?) printf "$0: illegal option -- $OPTARG\n * ${0##*/} -${mod} -h for help\n"
      esac
      exit
      ;;
    C) 
      shift $((OPTIND - 1)); 
      . "${baseDir}/${0##*/}/create.sh"
      case $OPTARG in
        "a" | "-a" | "--architecture") architecture ${@};;
        "d" | "-d" | "--directory") createDir ${@};;
        "f" | "-f" | "--file") createFile ${@};;
        "t" | "-t" | "--test") dryrun ${@};;
        "h" | "-h" | "--help") usage;;
        ?) printf "$0: illegal option -- $OPTARG\n * ${0##*/} -${mod} -h for help\n"
      esac
      exit;;
    T) 
      shift $((OPTIND - 1)); 
      . "${baseDir}/${0##*/}/templates.sh"
      case $OPTARG in
        "p" | "-p" | "--pkgbuild") pkgbuildFile ${@};;
        "i" | "-i" | "--install") installFile;;
        "c" | "-c" | "--command") cmdFile ${@};;
        "m" | "-m" | "--metapkg") metapkg ${@};;
        "l" | "-l" | "--pyproject") pyprojectFile ${@};;
        "t") extract $@;;
        "x" | "-x" | "--pycli") pycliFile ${@};;
        "h" | "-h" | "--help") usage;;
        ?) printf "$0: illegal option -- $OPTARG\n * ${0##*/} -${mod} -h for help\n"
      esac
      exit;;
    D)
      ${baseDir}/bin/padsutils;
      echo $author;
      INFO "This is a test...";
      ;;
    U) 
      shift $((OPTIND - 1))
      . "${baseDir}/${0##*/}/update.sh"
      case $OPTARG in
        "r" | "-r" | "--repository") updateRepo ${@};;
        "h" | "-h" | "--help") usage;;
        ?) printf "$0: illegal option -- $OPTARG\n * ${0##*/} -${mod} -h for help\n"
      esac
      exit;;
    x) set -$mod;;
    v) echo "${version}"; exit;;
    h) usage; exit;;
    ?) echo " * ${0##*/} -h for help"; exit 2;;
    *) status "K18 Error...$(CODE 2)";;
  esac
done

[[ $# -eq 0 ]] && manual && exit
#${baseDir}/bin/${cmd} -${param} ${@:2}
